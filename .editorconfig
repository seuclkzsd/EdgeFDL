# Editor settings shared by all contributors (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

[*.{html,css,js}]
indent_size = 2

[*.{yml,yaml,json,cff,toml}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard line breaks in some places; keep them.
trim_trailing_whitespace = false

[configs/intake_demo/configs/*.cfg]
# Sample device configurations keep the vendor's own layout (one-space indentation).
indent_size = unset

[results/**]
# Measured results and logs are raw data: keep them byte-exact.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
